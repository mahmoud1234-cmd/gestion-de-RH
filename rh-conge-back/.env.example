# Configuration Backend Spring Boot pour Vercel/Railway

# Base de données (PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/rh_conge_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=votre_mot_de_passe
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# JPA
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# CORS - À adapter selon votre domaine Vercel
CORS_ALLOWED_ORIGINS=https://votre-app.vercel.app,http://localhost:3000

# JWT / Sécurité
JWT_SECRET=votre_secret_jwt_tres_long_et_securise
JWT_EXPIRATION=86400000

# Serveur
SERVER_SERVLET_CONTEXT_PATH=/api
SERVER_PORT=8080

# Logging
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_RH=DEBUG
